# ─── ArcEarth Environment Variables ──────────────────────────────────────────
# Rename this file to .env and fill in any values you need.
# All variables are optional — the app runs and degrades gracefully without them.
# Never commit .env to source control (it is already in .gitignore).

# ── 3D Globe ──────────────────────────────────────────────────────────────────
# NASA Blue Marble Earth texture (8192×4096 PNG or JPG).
# When unset, ArcEarth renders a procedural deep-ocean sphere.
VITE_EARTH_TEXTURE_URL=

# ── EarthWatch / Impact ───────────────────────────────────────────────────────
# Base URL for a live planetary metrics API.
# When unset, the EarthImpact panel shows stub data.
VITE_IMPACT_API_URL=

# Map token for future Resium / CesiumJS high-fidelity renderer integration.
VITE_MAP_TOKEN=

# ── EarthImpact — On-Chain Contracts (Arc Testnet defaults pre-filled) ────────
# Override these to point at your own deployed contract instances.
VITE_IMPACT_REGISTRY_ADDRESS=0x725c40dcd969050a5cc38cb8a1d67948083a941b
VITE_ATTESTATION_ADDRESS=0x2c80bb55821154a8dc8acc0e76dd7fdad35dd308

# ── EarthImpact — IPFS / Pinata ───────────────────────────────────────────────
# Pinata JWT bearer token for evidence file uploads.
# When unset, the app simulates an IPFS CID locally (dev mode — no real upload).
# Generate one at: https://app.pinata.cloud/developers/api-keys
VITE_PINATA_JWT=
