# NOTE: All keys are hidden from view with asterisks (*), but if you highlight and copy them to paste outside Arc Studio, the real values will be copied.
FOO=bar

# ArcEarth environment variables
# Earth texture CDN URL (optional — fallback procedural globe used when absent)
VITE_EARTH_TEXTURE_URL=
# Impact metrics API base URL (optional — stub data used when absent)
VITE_IMPACT_API_URL=
# Map/Cesium token (reserved for future Resium integration)
VITE_MAP_TOKEN=

# EarthImpact — deployed on Arc Testnet
VITE_REGISTRY_ADDRESS=0x725c40dcd969050a5cc38cb8a1d67948083a941b
VITE_ATTESTATION_ADDRESS=0x2c80bb55821154a8dc8acc0e76dd7fdad35dd308
# Pinata JWT for IPFS evidence uploads (optional — simulated in dev when absent)
VITE_PINATA_JWT=
